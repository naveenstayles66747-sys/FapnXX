rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'x5WVi7rNpFeoDY6Q7vYv1Ss8Pgs2' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.email == 'naveenstayles66747@gmail.com'
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.moderator == true ||
        request.auth.token.role == 'MODERATOR' ||
        request.auth.token.role == 'EDITOR'
      );
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Explicit Public Media Assets: Videos, Previews, Thumbnails, Banners, Categories
    // ─────────────────────────────────────────────────────────────────────────────
    match /videos/{allPaths=**} {
      allow read: if true;
      // Allow authenticated staff/moderator video upload only (MP4/WebM/HLS, max 2GB)
      allow write: if isModerator() &&
        request.resource.size < 2048 * 1024 * 1024 &&
        (request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('application/x-mpegURL') || request.resource.contentType.matches('application/vnd.apple.mpegurl'));
    }

    match /previews/{allPaths=**} {
      allow read: if true;
      // Allow authenticated preview / animated thumbnail upload (Images/WebP/MP4, max 50MB)
      allow write: if isModerator() &&
        request.resource.size < 50 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    match /thumbnails/{allPaths=**} {
      allow read: if true;
      // Allow authenticated thumbnail upload (Images, max 20MB)
      allow write: if isModerator() &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      // Allow authenticated banner upload (Images, max 15MB)
      allow write: if isModerator() &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      // Allow authenticated category image upload (Images, max 15MB)
      allow write: if isModerator() &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      // User avatar upload (Max 5MB)
      allow write: if ((isAuthenticated() && request.auth.uid == userId) || isModerator()) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // User-specific upload directory (Isolated per authenticated user)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAuthenticated() && request.auth.uid == userId) || isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // DEFAULT DENY: Any unrecognized path outside explicit paths is strictly denied
    // ─────────────────────────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
