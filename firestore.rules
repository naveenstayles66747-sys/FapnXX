rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read/write access to active videos, categories, and landing banners
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Guest anonymous session mapping
    match /anonymous_uploaders/{deviceId} {
      allow read, write: if true;
    }

    // DMCA Reports & Content Moderation claims
    match /reports/{reportId} {
      allow read, create, update: if true;
    }

    // Ad Campaigns management
    match /ad_campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Category requests management
    match /category_requests/{requestId} {
      allow read, write: if true;
    }

    // Video comments
    match /comments/{commentId} {
      allow read, write: if true;
    }
  }
}
