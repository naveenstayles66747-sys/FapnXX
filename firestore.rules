rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow full read and write for all website interactions & server-side database syncing
    match /{document=**} {
      allow read, write: if true;
    }

    // Videos: Public read & real-time write/syncing
    match /videos/{videoId} {
      allow read, write: if true;
    }

    // Categories: Public read & real-time sync
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Landing Banners: Public read & real-time sync
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Ad Campaigns
    match /ad_campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Category Requests
    match /category_requests/{requestId} {
      allow read, write: if true;
    }

    // Comments: Public read, real-time create, update, delete
    match /comments/{commentId} {
      allow read, write: if true;
    }

    // DMCA & Moderation Reports
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // User Interactions (Saved videos, liked videos, watch history per device/user)
    match /user_interactions/{deviceId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Anonymous Uploaders & Audit Logs
    match /anonymous_uploaders/{deviceId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
