rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.role == 'EDITOR' ||
        request.auth.token.role == 'MODERATOR' ||
        request.auth.token.admin == true
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.admin == true
      );
    }

    // Videos: Public can read published videos. Writes strictly restricted to authorized staff/backend
    match /videos/{videoId} {
      allow read: if resource == null || resource.data.status == 'PUBLISHED' || resource.data.status == null || isStaff();
      allow create, update, delete: if isStaff();
    }

    // Categories: Public read, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Landing Banners: Public read active, Admin write
    match /banners/{bannerId} {
      allow read: if resource == null || resource.data.isActive == true || isStaff();
      allow write: if isAdmin();
    }

    // Ad Campaigns: Public read active, Admin write
    match /ad_campaigns/{campaignId} {
      allow read: if resource == null || resource.data.isActive == true || isStaff();
      allow write: if isAdmin();
    }

    // Category Requests: Authenticated users create, Staff manage
    match /category_requests/{requestId} {
      allow create: if isAuthenticated() || (request.resource.data.categoryName is string && request.resource.data.categoryName.size() > 1);
      allow read, update, delete: if isStaff();
    }

    // Comments: Public read, only authenticated users can post valid comments, anti-spam constraints
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // DMCA & Moderation Reports: Create allowed with proper schema, Staff manage
    match /reports/{reportId} {
      allow create: if request.resource.data.targetId is string && request.resource.data.reason is string;
      allow read, update, delete: if isStaff();
    }

    // Users Collection: User self-read/update, Admin full access
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Audit Logs: Completely locked from client-side direct access (Written strictly by server backend)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anonymous uploaders tracking: Locked from public direct writes
    match /anonymous_uploaders/{deviceId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}

