rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC) and data safety
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.admin == true
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'MODERATOR' ||
        request.auth.token.role == 'EDITOR' ||
        request.auth.token.moderator == true
      );
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // VIDEOS: Status-based read. Public can read ONLY published videos.
    // ─────────────────────────────────────────────────────────────────────────────
    match /videos/{videoId} {
      allow read: if resource.data.status == 'published' || resource.data.status == null || isModerator();
      
      // Create, Update, Delete: Strictly restricted to authenticated Staff / Admin / Server SDK
      // Prevents client-side counter tampering (views/likes/rating)
      allow create: if isModerator();
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // CATEGORIES: Public read. Write strictly restricted to Admin/Staff.
    // ─────────────────────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // LANDING BANNERS: Public read active banners. Write restricted to Admin/Staff.
    // ─────────────────────────────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if resource.data.isActive == true || resource.data.isActive == null || isModerator();
      allow write: if isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // AD CAMPAIGNS: Public read active campaigns. Write restricted to Admin/Staff.
    // ─────────────────────────────────────────────────────────────────────────────
    match /ad_campaigns/{campaignId} {
      allow read: if resource.data.isActive == true || resource.data.isActive == null || isModerator();
      allow write: if isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // CATEGORY REQUESTS: Anyone can submit a category request. Staff can read & manage.
    // ─────────────────────────────────────────────────────────────────────────────
    match /category_requests/{requestId} {
      allow create: if request.resource.data.categoryName is string && request.resource.data.categoryName.size() > 0;
      allow read, update, delete: if isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // COMMENTS: Status-based moderation. Approved comments are public.
    // ─────────────────────────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved' || resource.data.status == null || isModerator() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.keys().hasAll(['videoId', 'text', 'createdAt']) &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() <= 2000 &&
                       (!('isModerated' in request.resource.data) || isModerator()) &&
                       (!('moderatedBy' in request.resource.data) || isModerator());
      allow update: if isModerator() ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']);
      allow delete: if isModerator() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // REPORTS (DMCA & Abuse): Create allowed for all users. Read/Manage/Resolve strictly Staff.
    // ─────────────────────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasAll(['videoId', 'reason']) &&
                       request.resource.data.reason is string &&
                       (!('status' in request.resource.data) || request.resource.data.status == 'pending' || isModerator()) &&
                       (!('resolvedBy' in request.resource.data) || isModerator()) &&
                       (!('resolvedAt' in request.resource.data) || isModerator());
      allow read, update, delete: if isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // USER INTERACTIONS: Private interaction data (likes, watch history, saved).
    // Access: Owner only or authorized Staff (Moderator / Admin).
    // ─────────────────────────────────────────────────────────────────────────────
    match /user_interactions/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow write: if (isOwner(userId) || isModerator()) && (
        (!('savedVideos' in request.resource.data) || (request.resource.data.savedVideos is list && request.resource.data.savedVideos.size() <= 500)) &&
        (!('likedVideos' in request.resource.data) || (request.resource.data.likedVideos is list && request.resource.data.likedVideos.size() <= 1000)) &&
        (!('watchHistory' in request.resource.data) || (request.resource.data.watchHistory is list && request.resource.data.watchHistory.size() <= 100))
      );
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // USERS: Owner can update basic profile. Owner CANNOT modify role/permissions/status/admin flags.
    // ─────────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'permissions', 'status', 'banStatus', 'bannedAt', 'isBanned', 
          'isAdmin', 'admin', 'isModerator', 'moderator', 'email'
        ])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // AUDIT LOGS: 100% Tamper-proof. Direct client write is completely disabled.
    // ─────────────────────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isModerator();
      allow write: if false; // Server / Admin SDK ONLY
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // ANONYMOUS UPLOADERS
    // ─────────────────────────────────────────────────────────────────────────────
    match /anonymous_uploaders/{deviceId} {
      allow read, write: if isModerator();
    }
  }
}
